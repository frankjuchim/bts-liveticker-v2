# Vorlage: kopieren nach .env und Werte setzen
# Passwort, das in BTS beim Ticker eingetragen wird (leer lassen und im Admin-Panel setzen geht auch)
TICKER_PASSWORD=
# Admin-Passwort fest vorgeben (leer: Standard btsliveadmin, im Admin-Panel änderbar)
ADMIN_PASSWORD=
# Geheimer Schlüssel zwischen Liveticker und Watchtower (Update-Knopf), z. B. openssl rand -hex 16
UPDATE_TOKEN=
# Port auf dem Server
PORT=80
TITLE=Badminton
SUBTITLE=Turnier-Liveticker
