+				s: m.network_score || null, w: typeof m.team1_won === 'boolean' ? m.team1_won : null,
+				st: s.state || null, t: s.scheduled_time_str || null, dt: s.scheduled_date || null,
+			};
+			if (Array.isArray(s.btp_group_rankings)) {
+				res.rk = s.btp_group_rankings.map(r => ({ p: r.place_from, n: names(r.team), c: clubs(r.team) }));
+			}
+			return res;
+		});
+		cb(upcoming, draws);
+	});
+}
 function craft_match(m) {
 	const res = utils.pluck(m, ['_id']);
