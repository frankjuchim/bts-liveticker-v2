+				r: s.match_name || '', ph: s.phase_name_raw || '', mn: s.match_num || null,
+				pl: ids.planning != null ? ids.planning : null,
+				f1: l.from1 != null ? l.from1 : null, f2: l.from2 != null ? l.from2 : null,
