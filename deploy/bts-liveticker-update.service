[Unit]
Description=BTS Liveticker – Update aus dem Admin-Panel
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/bin/rm -f /var/lib/bts-liveticker/update.request
ExecStartPre=/bin/sh -c 'echo "UPDATE_STARTED $$(date -Is)" > /var/lib/bts-liveticker/update.log'
ExecStart=/bin/bash /opt/bts-liveticker/deploy/update.sh
StandardOutput=append:/var/lib/bts-liveticker/update.log
StandardError=append:/var/lib/bts-liveticker/update.log
ExecStopPost=/bin/sh -c 'echo "UPDATE_RESULT=$$SERVICE_RESULT $$(date -Is)" >> /var/lib/bts-liveticker/update.log'
TimeoutStartSec=15min
